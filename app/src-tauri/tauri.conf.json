{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JoyIME",
  "mainBinaryName": "joyime-app",
  "version": "0.1.0",
  "identifier": "com.joyime.app",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "cargo build -p joyime-tsf --release && cargo build -p joyime-tsf --release --target i686-pc-windows-msvc"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "用街机摇杆 / 手柄打字的输入法",
    "longDescription": "JoyIME：摇杆推方向、按键选字，支持中文九宫格、全拼、简拼、英文九宫格、字母和符号输入。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "JoyIME",
    "category": "Utility",
    "resources": {
      "../../target/release/joyime_tsf.dll": "joyime_tsf.dll",
      "../../target/i686-pc-windows-msvc/release/joyime_tsf.dll": "x86/joyime_tsf.dll",
      "icons/icon.ico": "joyime.ico"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh",
        "startMenuFolder": "JoyIME"
      }
    }
  }
}
